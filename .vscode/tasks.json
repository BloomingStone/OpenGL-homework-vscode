{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake Build Config [Debug]",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-DCMAKE_TOOLCHAIN_FILE=${env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
				"-DVCPKG_TARGET_TRIPLET=${config:vcpkg.target.defaultTriplet}",
				"-DCMAKE_BUILD_TYPE=Debug",
				"-S",
				"${workspaceFolder}",
				"-B",
				"${workspaceFolder}/build",
				"-G",
				"Ninja"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$msCompile"
			],
			"options": {
				"env": {
					"VCPKG_DEFAULT_TRIPLET": "x64-mingw-static",
					"VCPKG_DEFAULT_HOST_TRIPLET": "x64-mingw-static"
				}
			}
		},
		{
			"label": "CMake Build [Debug]",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/build",
				"--config",
				"Debug",
				"--clean-first"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$msCompile"
			],
			"dependsOn": "CMake Build Config [Debug]"
		},
		{
			"label": "CMake Build Config [Release]",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-DCMAKE_TOOLCHAIN_FILE=${env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
				"-DVCPKG_TARGET_TRIPLET=${config:vcpkg.target.defaultTriplet}",
				"-DCMAKE_BUILD_TYPE=Release",
				"-S",
				"${workspaceFolder}",
				"-B",
				"${workspaceFolder}/build",
				"-G",
				"Ninja"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$msCompile"
			],
			"options": {
				"env": {
					"VCPKG_DEFAULT_TRIPLET": "x64-mingw-static",
					"VCPKG_DEFAULT_HOST_TRIPLET": "x64-mingw-static"
				}
			}
		},
		{
			"label": "CMake Build [Release]",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/build",
				"--clean-first"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$msCompile"
			],
			"dependsOn": "CMake Build Config [Release]"
		}
	],
}
